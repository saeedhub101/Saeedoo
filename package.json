{
  "name": "saeed",
  "version": "0.7.0",
  "description": "Saeed — a Windows desktop AI companion inspired by classic animated assistants, rebuilt with modern LLM, voice, brain, tools, and customizable characters.",
  "main": "out/main/index.js",
  "author": "Saeed O. Almansour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saeedhub101/Saeedoo.git"
  },
  "homepage": "https://github.com/saeedhub101/Saeedoo#readme",
  "bugs": {
    "url": "https://github.com/saeedhub101/Saeedoo/issues"
  },
  "keywords": [
    "electron",
    "desktop-assistant",
    "ai",
    "llm",
    "microsoft-agent",
    "anthropic",
    "openai",
    "groq",
    "ollama",
    "hermes-agent",
    "voice",
    "tts",
    "whisper",
    "saeed",
    "desktop-assistant",
    "ai-companion"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-saeed-runtime-assets.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run assets && electron-vite build && playwright test",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test:all": "npm run test:unit && npm run verify:assets && npm run test:e2e",
    "dist": "npm run assets && node scripts/verify-assets.mjs && electron-vite build && node scripts/verify-assets.mjs --build && electron-builder && node scripts/verify-assets.mjs --package",
    "dist:portable": "npm run assets && node scripts/verify-assets.mjs && electron-vite build && node scripts/verify-assets.mjs --build && electron-builder --config.win.target=portable && node scripts/verify-assets.mjs --package",
    "assets": "node scripts/prepare-saeed-assets.mjs",
    "postinstall": "electron-builder install-app-deps",
    "check:version": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "ai": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^10.0.0",
    "marked": "^14.1.3",
    "msedge-tts": "^2.0.5",
    "ollama-ai-provider": "^1.0.0",
    "zod": "^3.23.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.0.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^2.1.8",
    "prettier": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "@electron/asar": "^3.4.1"
  }
}
